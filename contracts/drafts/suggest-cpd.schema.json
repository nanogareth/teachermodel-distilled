{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tm:contract/drafts/suggest-cpd@1",
  "title": "Draft content: suggest-cpd",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activities",
    "message"
  ],
  "properties": {
    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "title",
          "why"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "description": "One activity"
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  },
  "description": "Development activities for the instructor's lowest domains"
}
