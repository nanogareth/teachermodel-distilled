{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tm:contract/drafts/find-cover@1",
  "title": "Draft content: find-cover",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "options",
    "message"
  ],
  "properties": {
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instructor",
          "reason"
        ],
        "properties": {
          "instructor": {
            "type": "string",
            "pattern": "^tm:(person|instructor)/[a-z0-9][a-z0-9-]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "description": "One cover option"
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    }
  },
  "description": "Ranked cover options and a message to the first; the decision is the head's"
}
